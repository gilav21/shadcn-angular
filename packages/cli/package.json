{
    "name": "@gilav21/shadcn-angular",
    "version": "0.0.48",
    "description": "CLI for adding shadcn-angular components to your project",
    "bin": {
        "shadcn-angular": "./dist/index.js"
    },
    "main": "./dist/index.js",
    "type": "module",
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
        "build": "npm run clean && tsc",
        "prepublishOnly": "npm run build",
        "dev": "tsc --watch",
        "start": "node dist/index.js",
        "typecheck:scripts": "tsc -p tsconfig.scripts.json",
        "sync-registry": "tsx scripts/sync-registry.ts",
        "sync-registry:fix": "tsx scripts/sync-registry.ts --fix",
        "gen-baselines": "npm run build && node scripts/gen-legacy-baselines.mjs"
    },
    "keywords": [
        "angular",
        "shadcn",
        "cli",
        "components"
    ],
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.29.0",
        "chalk": "^5.3.0",
        "commander": "^12.1.0",
        "execa": "^9.3.0",
        "fs-extra": "^11.2.0",
        "ora": "^8.0.1",
        "prompts": "^2.4.2",
        "zod": "^3.25.76"
    },
    "devDependencies": {
        "@types/fs-extra": "^11.0.4",
        "@types/node": "^20.14.0",
        "@types/prompts": "^2.4.9",
        "typescript": "^5.5.0"
    }
}
