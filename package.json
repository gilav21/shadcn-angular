{
  "name": "shadcn-angular",
  "version": "0.0.1",
  "description": "Angular port of shadcn/ui - beautifully designed components",
  "private": true,
  "workspaces": [
    "packages/*",
    "demo"
  ],
  "scripts": {
    "prepare": "simple-git-hooks",
    "build:cli": "cd packages/cli && npm run build",
    "release:cli": "tsx packages/cli/scripts/release-cli.ts",
    "preflight": "node scripts/preflight.mjs",
    "check:completeness": "tsx packages/cli/scripts/check-completeness.ts",
    "check:registry": "tsx packages/cli/scripts/sync-registry.ts",
    "hook:pre-commit": "lint-staged && npm run a11y:staged && npm run typecheck",
    "hook:pre-push": "node scripts/pre-push.mjs",
    "a11y:staged": "node scripts/a11y-staged.mjs",
    "build:demo": "cd demo && npm run build",
    "dev": "cd demo && npm run start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:templates": "ngc -p tsconfig.json --noEmit",
    "check:all": "npm run lint && npm run typecheck && npm run typecheck:templates",
    "coverage": "cross-env HEADLESS=1 vitest --run --coverage && npm run coverage:cli && node scripts/fix-lcov.mjs",
    "coverage:cli": "vitest --config vitest.config.cli.ts --run --coverage",
    "sonar": "node scripts/sonar.mjs",
    "sonar:export": "node scripts/sonar-export.mjs",
    "test": "vitest",
    "test:headed": "cross-env HEADED=1 vitest",
    "test:headless": "vitest --config vitest.config.headless.ts",
    "test:ci": "cross-env HEADLESS=1 vitest --run",
    "test:ci:coverage": "cross-env HEADLESS=1 vitest --run --coverage",
    "storybook": "npm run docs:json && ng run demo:storybook",
    "build-storybook": "npm run docs:json && ng run demo:build-storybook",
    "test-visual": "vitest --browser=chromium",
    "test-storybook": "node scripts/test-storybook.mjs",
    "test-storybook:a11y": "cross-env STORYBOOK_A11Y=1 node scripts/test-storybook.mjs",
    "test:cli": "vitest --config vitest.config.cli.ts",
    "docs:json": "compodoc -p tsconfig.json -e json -d .",
    "e2e:build-cli": "cd packages/cli && npm run build",
    "e2e": "tsx e2e/orchestrator/run.ts",
    "e2e:headed": "tsx e2e/orchestrator/run.ts --headed",
    "e2e:ui": "tsx e2e/orchestrator/run.ts --ui",
    "e2e:debug": "tsx e2e/orchestrator/run.ts --debug",
    "e2e:reset": "tsx e2e/orchestrator/reset.ts",
    "e2e:reset:jest": "tsx e2e/orchestrator/reset-with-runner.ts jest",
    "e2e:reset:vitest": "tsx e2e/orchestrator/reset-with-runner.ts vitest",
    "e2e:impact": "tsx e2e/orchestrator/impact.ts",
    "e2e:scaffold": "tsx e2e/orchestrator/scaffold.ts",
    "new:component": "tsx packages/cli/scripts/new-component.ts",
    "test:portable": "vitest run --config vitest.portable.config.ts",
    "verify:portable": "tsx packages/cli/scripts/verify-portable.ts",
    "verify:jest": "node e2e/jest-fixture/run.mjs"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run hook:pre-commit",
    "pre-push": "npm run hook:pre-push"
  },
  "lint-staged": {
    "*.{ts,mjs,js,html}": "eslint --fix --no-warn-ignored"
  },
  "keywords": [
    "angular",
    "shadcn",
    "ui",
    "components",
    "tailwind"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@analogjs/platform": "^2.5.0",
    "@analogjs/vite-plugin-angular": "^2.5.0",
    "@analogjs/vitest-angular": "^2.5.0",
    "@compodoc/compodoc": "^1.1.32",
    "@eslint/js": "^9.39.4",
    "@jest/globals": "^30.4.1",
    "@playwright/test": "^1.57.0",
    "@storybook/addon-a11y": "^10.1.11",
    "@storybook/addon-docs": "^10.1.11",
    "@storybook/addon-onboarding": "^10.1.11",
    "@storybook/angular": "^10.1.11",
    "@storybook/test-runner": "^0.24.2",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^20.14.0",
    "@vitest/browser": "^4.1.9",
    "@vitest/browser-playwright": "^4.1.9",
    "@vitest/coverage-v8": "^4.1.9",
    "angular-eslint": "^21.4.0",
    "axe-playwright": "^2.2.2",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.4",
    "eslint-plugin-sonarjs": "^4.1.0",
    "jest-environment-jsdom": "^30.4.1",
    "jest-preset-angular": "^17.0.0",
    "jsdom": "^27.4.0",
    "lint-staged": "^17.0.8",
    "lmdb": "^3.5.4",
    "playwright": "^1.57.0",
    "postcss": "^8.5.10",
    "rollup": "^4.60.1",
    "simple-git-hooks": "^2.13.1",
    "storybook": "^10.3.5",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.19.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.61.0",
    "vite": "^7.3.5",
    "vitest": "^4.1.9",
    "zone.js": "^0.15.1"
  },
  "dependencies": {
    "lightningcss": "^1.30.2"
  },
  "overrides": {
    "@babel/plugin-transform-modules-systemjs": "^7.29.4",
    "ajv": "^8.17.2",
    "eslint": {
      "ajv": "^6.14.0"
    },
    "@eslint/eslintrc": {
      "ajv": "^6.14.0"
    },
    "fast-uri": "^3.1.2",
    "hono": "^4.12.25",
    "ip-address": "^10.1.1",
    "picomatch": "^4.0.4",
    "postcss": "^8.5.10",
    "uuid": "^11.1.1",
    "shell-quote": "^1.8.4",
    "form-data": "^4.0.6",
    "tar": "^7.5.16",
    "js-yaml": "^4.2.0",
    "launch-editor": "^2.14.1",
    "@babel/core": "^7.29.6",
    "esbuild": "^0.28.1",
    "vite": "^7.3.5",
    "webpack-dev-server": "^5.2.4",
    "undici@>=7.0.0 <7.28.0": "7.28.0",
    "http-proxy-middleware@>=3.0.0 <3.0.7": "3.0.7",
    "piscina@>=5.0.0-alpha.0 <5.2.0": "5.2.0",
    "@angular-devkit/build-angular": {
      "webpack-dev-server": "^5.2.4"
    }
  }
}
