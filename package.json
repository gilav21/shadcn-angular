{
  "name": "shadcn-angular",
  "version": "0.0.1",
  "description": "Angular port of shadcn/ui - beautifully designed components",
  "private": true,
  "workspaces": [
    "packages/*",
    "demo"
  ],
  "scripts": {
    "build:cli": "cd packages/cli && npm run build",
    "publish:cli": "cd packages/cli && npm version patch && npm publish",
    "build:demo": "cd demo && npm run build",
    "dev": "cd demo && npm run start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:templates": "ngc -p tsconfig.json --noEmit",
    "check:all": "npm run lint && npm run typecheck && npm run typecheck:templates",
    "coverage": "HEADLESS=1 vitest --run --coverage && node scripts/fix-lcov.mjs",
    "sonar": "node scripts/sonar.mjs",
    "sonar:export": "node scripts/sonar-export.mjs",
    "test": "vitest",
    "test:headless": "vitest --config vitest.config.headless.ts",
    "test:ci": "HEADLESS=1 vitest --run",
    "storybook": "npm run docs:json && ng run demo:storybook",
    "build-storybook": "npm run docs:json && ng run demo:build-storybook",
    "test-visual": "vitest --browser=chromium",
    "test:cli": "vitest --config vitest.config.cli.ts",
    "docs:json": "compodoc -p tsconfig.json -e json -d .",
    "e2e:build-cli": "cd packages/cli && npm run build",
    "e2e": "tsx e2e/orchestrator/run.ts",
    "e2e:headed": "tsx e2e/orchestrator/run.ts --headed",
    "e2e:ui": "tsx e2e/orchestrator/run.ts --ui",
    "e2e:debug": "tsx e2e/orchestrator/run.ts --debug",
    "e2e:reset": "tsx e2e/orchestrator/reset.ts",
    "e2e:impact": "tsx e2e/orchestrator/impact.ts",
    "e2e:scaffold": "tsx e2e/orchestrator/scaffold.ts"
  },
  "keywords": [
    "angular",
    "shadcn",
    "ui",
    "components",
    "tailwind"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@analogjs/platform": "^2.5.0",
    "@analogjs/vite-plugin-angular": "^2.5.0",
    "@analogjs/vitest-angular": "^2.5.0",
    "@compodoc/compodoc": "^1.1.32",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.57.0",
    "@storybook/addon-a11y": "^10.1.11",
    "@storybook/addon-docs": "^10.1.11",
    "@storybook/addon-onboarding": "^10.1.11",
    "@storybook/angular": "^10.1.11",
    "@storybook/test-runner": "^0.24.2",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^20.14.0",
    "@vitest/browser": "^4.0.17",
    "@vitest/browser-playwright": "^4.0.17",
    "@vitest/coverage-v8": "^4.1.7",
    "angular-eslint": "^21.4.0",
    "axe-playwright": "^2.2.2",
    "esbuild": "0.27.3",
    "eslint": "^9.39.4",
    "eslint-plugin-sonarjs": "^4.0.3",
    "jsdom": "^27.4.0",
    "lmdb": "^3.5.4",
    "playwright": "^1.57.0",
    "postcss": "^8.5.10",
    "rollup": "^4.60.1",
    "storybook": "^10.3.5",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.19.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.61.0",
    "vite": "^7.3.2",
    "vitest": "^4.0.17"
  },
  "dependencies": {
    "lightningcss": "^1.30.2"
  },
  "overrides": {
    "@babel/plugin-transform-modules-systemjs": "^7.29.4",
    "ajv": "^8.17.2",
    "eslint": {
      "ajv": "^6.14.0"
    },
    "@eslint/eslintrc": {
      "ajv": "^6.14.0"
    },
    "fast-uri": "^3.1.2",
    "hono": "^4.12.18",
    "ip-address": "^10.1.1",
    "picomatch": "^4.0.4",
    "postcss": "^8.5.10",
    "uuid": "^11.1.1",
    "webpack-dev-server": "^5.2.4",
    "@angular-devkit/build-angular": {
      "webpack-dev-server": "^5.2.4"
    }
  }
}
