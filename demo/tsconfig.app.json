/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/app",
    "types": [],
    "paths": {
      /* The recipes in ../e2e/recipes import through the consumer alias
         (@/components/ui/...), because they must compile unchanged inside the
         fixture app a real consumer gets. Mapping that prefix at the library
         lets the demo render the very same files live instead of printing
         their source — one source of truth, no copy to drift. */
      "@/components/*": [
        "../packages/components/*"
      ],
      "@/*": [
        "src/*"
      ]
    },
    "baseUrl": "."
  },
  "include": [
    "src/**/*.ts",
    "../e2e/recipes/**/*.recipe.ts"
  ],
  "exclude": [
    "src/**/*.spec.ts"
  ]
}