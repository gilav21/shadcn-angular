
{
  "worktree": {"bgIsolation": "none"},
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/validate-registry.mjs",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '[SonarQube] If you edited .ts files: ensure cognitive complexity <= 15, use modern APIs, no nested ternaries, max 7 params. Run /sonar before committing.'",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
