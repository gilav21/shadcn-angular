{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/validate-registry.mjs",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.command // \"\"' | grep -q '^git commit' && { npx tsx packages/cli/scripts/sync-registry.ts --fix && git add packages/cli/src/registry/index.ts; } || true",
            "timeout": 60,
            "statusMessage": "Syncing registry..."
          }
        ]
      }
    ]
  }
}
