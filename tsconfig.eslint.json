{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": [
    "packages/**/*.ts",
    "demo/**/*.ts",
    "e2e/**/*.ts",
    "scripts/**/*.ts",
    "*.ts"
  ],
  "exclude": [
    "**/node_modules",
    "**/dist",
    "e2e/fixture-app",
    "e2e/fixture-app-21",
    "packages/*-package/src/**"
  ]
}
